		{
			"name": "add book by id",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let randomColor = pm.variables.replaceIn('{{$randomColor}}')\r",
							"let randomMonth = pm.variables.replaceIn('{{$randomMonth}}')\r",
							"let random1 = parseInt(pm.variables.replaceIn('{{$randomInt}}')) * 2\r",
							"let random2 = parseInt(pm.variables.replaceIn('{{$randomInt}}')) * 9\r",
							"let randomisbn = parseInt(pm.variables.replaceIn('{{$randomInt}}')) * 8\r",
							"let authorname1 = pm.variables.replaceIn('{{$randomFullName}}')\r",
							"\r",
							"pm.collectionVariables.set(\"newBookName\", randomColor + \" \" + randomMonth);\r",
							"pm.collectionVariables.set(\"newISBN\", randomisbn + random1 * random2);\r",
							"pm.collectionVariables.set(\"newAisie\", randomisbn * random1 * random2 + 2);\r",
							"pm.collectionVariables.set(\"newAuthorName\", authorname1);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let myResponse = pm.response.json();\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"this is to test that successfully added\", function () {\r",
							"    pm.expect(myResponse).to.have.property('Msg', \"successfully added\");\r",
							"});\r",
							"\r",
							"pm.collectionVariables.set('BookID', myResponse.ID);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
