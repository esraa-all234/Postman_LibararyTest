					"listen": "test",
					"script": {
						"exec": [
							"let getResponse = pm.response.json();\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"if (Array.isArray(getResponse) && getResponse.length > 0) {\r",
							"    pm.test(\"Book details exist\", function () {\r",
							"        pm.expect(getResponse[0]).to.have.property(\"book_name\");\r",
							"        pm.expect(getResponse[0]).to.have.property(\"isbn\");\r",
							"    });\r",
							"} else {\r",
							"    pm.test(\"Book not found\", function () {\r",
							"        pm.expect(getResponse).to.eql({\r",
							"            \"msg\": \"The book by requested bookid / author name does not exists!\"\r",
							"        });\r",
							"    });\r",
							"}"
						],
